# Copy this file to .env and fill in local-only values.
AWS_S3_BUCKET=nomat-dev-assets-your-unique-value
AWS_REGION=ap-northeast-2
AWS_S3_PUBLIC_BASE_URL=https://your-cloudfront-domain.cloudfront.net/

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Gmail account with 2-Step Verification enabled. Use a Google App Password, not the account password.
GMAIL_USERNAME=your-account@gmail.com
GMAIL_APP_PASSWORD=
MAIL_FROM=your-account@gmail.com
EMAIL_DELIVERY_MODE=smtp
