# This file lists every environment variable used by local and production deployments.
# Copy it to a secret-managed environment file. Never commit populated credentials.

# Production database. DB_URL must be a full JDBC URL.
DB_URL="jdbc:mysql://mysql:3306/nomat?useSSL=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8"
DB_USERNAME=
DB_PASSWORD=

# Shared Redis used by every backend instance.
REDIS_URL=redis://redis:6379

# Secrets must contain at least 32 bytes. Generate unique random values for production.
JWT_SECRET=
ADMIN_API_KEY=

# Public frontend origin. WebSocket connections from other origins are rejected.
FRONTEND_ORIGIN=https://example.com

# Private CIDRs of the VPC subnets that contain the ALB nodes.
# Keep the backend port closed to every source except the ALB security group.
TRUSTED_PROXY_CIDRS=10.0.0.0/16

# Actuator runs separately from the public application port. In production,
# allow this port only from the monitoring security group and never from the ALB.
MANAGEMENT_SERVER_PORT=9091
MANAGEMENT_SERVER_ADDRESS=0.0.0.0
APP_ENVIRONMENT=prod

# S3 storage. AWS access keys may be omitted when the server uses an IAM role.
AWS_S3_BUCKET=nomat-assets-your-unique-value
AWS_REGION=ap-northeast-2
AWS_S3_PUBLIC_BASE_URL=https://your-cloudfront-domain.cloudfront.net/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Production uses SES API and the EC2 Instance Role (AWS_REGION above).
MAIL_FROM=no-reply@nomat.cloud
# Gmail SMTP below is for local development only. prod fixes delivery-mode=ses.
# For local SMTP, override MAIL_FROM above with the Gmail sender address.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
GMAIL_USERNAME=your-account@gmail.com
GMAIL_APP_PASSWORD=
EMAIL_DELIVERY_MODE=smtp
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

# Every production server must declare whether it also runs audio workers.
AUDIO_PROCESSING_ENABLED=true
AUDIO_PROCESSING_WORKER_CONCURRENCY=2
AUDIO_PROCESSING_YOUTUBE_MAX_CONCURRENCY=4
AUDIO_PROCESSING_YOUTUBE_PERMIT_LEASE_SECONDS=120
AUDIO_PROCESSING_YOUTUBE_PERMIT_RENEWAL_MS=30000
AUDIO_PROCESSING_SCHEDULER_FIXED_DELAY_MS=10000
AUDIO_PROCESSING_HEARTBEAT_INTERVAL_MS=20000
AUDIO_PROCESSING_HEARTBEAT_TIMEOUT_SECONDS=90
AUDIO_PROCESSING_DELAYED_THRESHOLD_MINUTES=30
YT_DLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
AUDIO_OUTPUT_BITRATE=128k

# Rooms expire after this many minutes without room activity or a client heartbeat.
ROOM_INACTIVITY_TTL_MINUTES=15
ROOM_EVENT_CHANNEL=nomat:rooms:events
ROOM_WEBSOCKET_SESSION_TTL_MINUTES=10
ROOM_GAME_TIMER_INITIAL_DELAY_MS=1000
ROOM_GAME_TIMER_FIXED_DELAY_MS=100
ROOM_GAME_TIMER_BATCH_SIZE=100
ROOM_GAME_TIMER_LEASE_DURATION_MS=5000
ROOM_GAME_TIMER_EXECUTION_LOCK_DURATION_MS=30000

# Cookie policy is fixed by application-prod.yaml: Secure=true and SameSite=Lax.
# HTTPS termination and /api proxying must be configured by the reverse proxy.
# These overrides are available only for non-production profiles.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
